# 部署配置模板：cp .env.k3.example .env.k3 再改
# 该文件不入 git（.gitignore 已忽略 .env.k3），因为可能含 sudo 密码。

# ---- 跳板机 / 板子接入 ----
JUMP="root@111.228.40.211"
TTYD="k3-ttyd"
KEY="/app/ssh/id_ed25519"
BOARD_PORT="2222"
BOARD_USER="pingji"
BOARD_IP="192.168.110.194"
# 板子直连（同局域网）时设 1，并保证 ssh 端口是 22
K3_DIRECT="0"

# ---- 板子上跑 Cuttlefish 的目录 ----
CF_REPO="https://github.com/monkey-jsun/cuttlefish-host-container"
CF_DIR="k3-android/cuttlefish-host-container"
PKG_DIR="k3-android/pkg"

# ---- 镜像 / 内核版本（建议 pin 死，别用 latest）----
CF_IMAGE="ghcr.io/monkey-jsun/aosp-cuttlefish-riscv64/cf-host-k3:latest"
CF_IMAGE_TAG="cf-host-k3"
# 留空 = 自动取 upstream releases/latest；被 GitHub API 限流时手动填
KERNEL_DEB_URL=""

# ---- 端口映射 ----
# 板子 guest 侧
GW_WEBRTC="8443"
GW_ADB="6520"
# 111 上对外的端口（高位，避免占用冲突连带打挂隧道）
RW_WEBRTC="18443"
RW_ADB="16520"

# ---- sudo ----
# 板子 pingji 有 sudo 但要密码。两种给法（二选一）：
#   1) 放这里（注意本文件不入 git）
#   2) 写到 ~/.k3-sudo（0600），脚本会自动读
# K3_SUDO_PASS=""

# ---- 板子代理（Xray）----
# 板子到 GitHub/ghcr 的 TLS 会被掐断，用它兜。真实配置在 xray/config.json（不入 git）。
XRAY_VER="v26.3.27"
XRAY_PORT="10808"          # 必须与 xray/config.json 里的 inbound 端口一致
XRAY_DIR="k3-android/xray" # 板子上的中转目录（相对 $HOME）
