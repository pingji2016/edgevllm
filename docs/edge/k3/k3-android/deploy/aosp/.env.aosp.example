# 编译机配置模板：cp .env.aosp.example .env.aosp 再改
# 该文件不入 git（.gitignore 的 `.env.*` 已忽略，`.example` 例外）。

# ---- 编译机 --------------------------------------------------------------
HOST="root@1.2.3.4"          # 云主机（远端模式下必填；在编译机上跑就不需要）
# SSH_KEY="~/.ssh/id_ed25519"

# ---- 目录（相对编译机的 $HOME，也可以写绝对路径）--------------------------
TREE="android17-release"     # AOSP 源码树（官方数字：同步 ~150GB、编完 ~320GB）
KERNEL_DIR="linux-6.18-k3"   # 内核树

# ---- 上游与版本（建议 pin 死，别用浮动分支）-------------------------------
ADDONS_REPO="https://github.com/monkey-jsun/aosp-cuttlefish-riscv64-addons"
BRANCH="v1.3.1"              # 实测上游只有 v1.2 / v1.3.1 两个 tag；v1.3.1 = 板子上正在跑的镜像。要最新开发分支用 main
MANIFEST="manifests/aosp-cf-js-baseline.xml"
PRODUCT="aosp_cf_riscv64_phone_js-trunk_staging-userdebug"
BUILD_NUMBER="v1.3.1"        # 产物名 aosp_cf_riscv64_phone_js-img-<这个>.zip；自己改的版本换个号

# ---- 内核交叉编译（另一条线，约 10 分钟）---------------------------------
KERNEL_REPO="https://github.com/monkey-jsun/linux-6.18-k3.git"
KERNEL_BRANCH="cf-k3-v1.3.0"
KERNEL_DEFCONFIG="config-aia2-kvm-modular"
KERNEL_LOCALVERSION="-cf-k3-1.3.0"
KERNEL_PKGVERSION="6.18.3-cf-k3-1.3.0"

# ---- 网络 -----------------------------------------------------------------
# 境外区域留空即可。国内区域若 googlesource 慢：先 `mirror-on`（只重定向 googlesource）；
# 若 GitHub 也慢：给个代理。
PROXY=""
# PROXY="socks5h://127.0.0.1:10808"
JOBS="8"                     # repo sync 并发

# ---- 性能 / 其他 ----------------------------------------------------------
USE_CCACHE="0"               # 1 = 启用 ccache（增量编更快，但吃盘）
GIT_NAME="aosp-builder"      # repo / 补丁脚本要求有 git 身份
GIT_EMAIL="aosp-builder@localhost"
OUTPUT_DIR=""                # `fetch` 拉回本机的落地目录；留空 = <repo>/out/aosp
